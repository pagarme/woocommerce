/**
 * Containers do 3DS NX. Ficam fora do modal legado porque a lib do AuthSwitch
 * injeta o iframe do challenge aqui dentro e o posiciona via CSS — um ancestral
 * com `display: none` impediria a renderização. A aplicação não deve mexer na
 * estrutura interna destes elementos.
 */
?>
<div id="tdsMethodContainer" style="display: none;"></div>
<div id="challengeContainer"></div>

<script>
(function () {
    /**
     * O template é reinjetado a cada `updated_checkout`, então os scripts inline
     * rodam novamente. Sem esse guard os SDKs seriam baixados a cada atualização
     * do checkout e o cache de carregamento seria substituído no meio de uma
     * autenticação em andamento.
     */
    if (window.pagarmeTds3ds) {
        return;
    }

    const urls = {
        nx: [
            "<?= esc_url($this->getAuthSwitchUrl()); ?>",
            "<?= esc_url($this->get3DsNxUrl()); ?>",
        ],
        legacy: ["<?= esc_url($this->getSdkUrl()); ?>"],
    };

    function loadScript(src) {
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.async = true;
            script.onload = () => resolve(src);
            script.onerror = () => reject(new Error(`Falha ao carregar o script: ${src}`));
            document.head.appendChild(script);
        });
    }

    /**
     * Um engine só é considerado pronto quando a função que de fato executa a
     * autenticação existe. Checar apenas a presença do objeto global deixaria o
     * checkout escolher um SDK que não sabemos chamar.
     */
    const verifiers = {
        nx: () => typeof window.tifa?.init === 'function',
        legacy: () => typeof window.Script3ds?.init3ds === 'function',
    };

    const loaded = {};

    /**
     * O engine é definido pelo backend, que sabe qual emissor gerou o token —
     * um token NX é rejeitado pela API do 3DS legado, então o checkout troca os
     * dois juntos quando precisa cair no fallback.
     * Para o NX os dois scripts (AuthSwitch e 3DS NX) são obrigatórios.
     */
    function load(engine) {
        if (!urls[engine]) {
            return Promise.reject(new Error(`Engine de 3DS desconhecido: ${engine}`));
        }

        if (!loaded[engine]) {
            loaded[engine] = Promise.all(urls[engine].map(loadScript)).then(() => {
                if (!verifiers[engine]()) {
                    throw new Error(
                        `SDK de 3DS "${engine}" carregou, mas não expôs uma API de autenticação utilizável.`
                    );
                }
                return engine;
            }).catch((error) => {
                // Sem limpar o cache, uma falha de rede no warm-up condenaria
                // todas as tentativas seguintes de checkout da mesma página.
                delete loaded[engine];
                throw error;
            });
        }

        return loaded[engine];
    }

    window.pagarmeTds3ds = { load };

    /**
     * Warm-up: a maioria das contas já está no NX, então adiantamos o download
     * para não pagar a latência dos dois scripts no submit. O engine legado
     * continua carregando sob demanda, no fallback. Uma falha aqui não quebra o
     * checkout: o cache é limpo e o submit ainda tenta o NX antes do fallback.
     */
    load('nx').catch((error) => {
        console.warn('[Pagar.me 3DS] Pré-carregamento do 3DS NX falhou.', error);
    });
})();
</script>
