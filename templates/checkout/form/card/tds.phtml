/** @var \Woocommerce\Pagarme\Block\Checkout\Form\Tds $this */

if (!$this->canInitTds()) {
    return;
}

?>

<?php // Containers do 3DS NX ?>
<div id="tdsMethodContainer" style="display: none;"></div>
<div id="challengeContainer"></div>

<script>
(function () {
    /**
     * O template é reinjetado a cada `updated_checkout`, então os scripts inline
     * rodam novamente. Sem esse guard os SDKs seriam baixados a cada atualização
     * do checkout e o cache de carregamento seria substituído no meio de uma
     * autenticação em andamento.
     */
    if (window.pagarmeTds3ds) {
        return;
    }

    const TDS_NX_URL = "<?= esc_url($this->get3DsNxUrl()); ?>";

    function loadScript(src) {
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.async = true;
            script.onload = () => resolve(src);
            script.onerror = () => reject(new Error(`Falha ao carregar o script: ${src}`));
            document.head.appendChild(script);
        });
    }

    let tdsNxLoaded = null;

    function load() {
        if (!tdsNxLoaded) {
            tdsNxLoaded = loadScript(TDS_NX_URL).then(() => {
                if (typeof window.TDS?.init !== 'function') {
                    throw new Error('3DS NX carregou, mas a API não está disponível.');
                }
            }).catch((error) => {
                tdsNxLoaded = null;
                throw error;
            });
        }
        return tdsNxLoaded;
    }

    window.pagarmeTds3ds = { load };

    load().catch((error) => {
        console.warn('[Pagar.me 3DS] Pré-carregamento falhou.', error);
    });
})();
</script>
